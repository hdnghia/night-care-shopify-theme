{% comment %}
  Static before/after unit for dm-before-after-slider section.
  Expects: aspect_ratio, before_media, after_media, dm_before_asset, dm_after_asset,
  before_label, after_label, slider_extra_class (optional)
{% endcomment %}
<div
  class="dm-before-after__slider dm-before-after__static {{ slider_extra_class }}"
  style="--ratio: {{ aspect_ratio }};"
>
  <div class="dm-before-after__static-media">
    <span class="dm-before-after__duration">90 DAYS OF USE</span>

    <div class="dm-before-after__static-panel dm-before-after__static-panel--before">
      {% if before_media != blank %}
        {{
          before_media
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            decoding: 'async',
            class: 'dm-before-after__image',
            alt: before_label,
            sizes: '(max-width: 767px) calc(50vw - 18px), 560px',
            width: before_media.width,
            height: before_media.height
        }}
      {% elsif dm_before_asset != blank %}
        <img
          src="{{ dm_before_asset | asset_url }}"
          class="dm-before-after__image"
          alt="{{ before_label | escape }}"
          loading="lazy"
          decoding="async"
          width="1200"
          height="1200"
        >
      {% else %}
        <div class="dm-before-after__placeholder">
          {{ 'product-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
      <span class="dm-before-after__label dm-before-after__label--before">
        {{ before_label }}
      </span>
    </div>

    <div class="dm-before-after__static-panel dm-before-after__static-panel--after">
      {% if after_media != blank %}
        {{
          after_media
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            decoding: 'async',
            class: 'dm-before-after__image',
            alt: after_label,
            sizes: '(max-width: 767px) calc(50vw - 18px), 560px',
            width: after_media.width,
            height: after_media.height
        }}
      {% elsif dm_after_asset != blank %}
        <img
          src="{{ dm_after_asset | asset_url }}"
          class="dm-before-after__image"
          alt="{{ after_label | escape }}"
          loading="lazy"
          decoding="async"
          width="1200"
          height="1200"
        >
      {% else %}
        <div class="dm-before-after__placeholder">
          {{ 'product-apparel-2' | placeholder_svg_tag }}
        </div>
      {% endif %}
      <span class="dm-before-after__label dm-before-after__label--after">
        {{ after_label }}
      </span>
    </div>
  </div>
</div>
